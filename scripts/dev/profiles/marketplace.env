# Services marketplace vertical on its own (no eCommerce). Overrides on top of maestro/.env (see scripts/dev/README.md).
ENABLED_MODULES=core,marketplace
MONGODB_DB_NAME=xCloud-marketplace
REDIS_DATABASE=6
KAFKA_PREFIX=marketplace
SERVER_PORT=131
WEBSOCKET_PORT=132
PANEL_PORT=5221
PUBLIC_APP=portal
PUBLIC_PORT=5222
# Own zone, so the portal's session cookie never mixes with another running profile's.
PORTAL_ROOT_DOMAIN=marketplace.localhost
