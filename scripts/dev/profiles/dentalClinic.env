# Dental clinic vertical. Overrides on top of maestro/.env (see scripts/dev/README.md).
ENABLED_MODULES=core,dentalClinic
MONGODB_DB_NAME=xCloud-dentalClinic
REDIS_DATABASE=3
KAFKA_PREFIX=dentalClinic
SERVER_PORT=101
WEBSOCKET_PORT=102
PANEL_PORT=5191
PUBLIC_APP=portal
PUBLIC_PORT=5192
# Own zone, so the portal's session cookie never mixes with another running profile's.
PORTAL_ROOT_DOMAIN=dentalclinic.localhost
