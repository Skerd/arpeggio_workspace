# eCommerce vertical: today's default setup (database, Redis DB 0, unprefixed Kafka, ports 81/82/5173/5174).
ENABLED_MODULES=core,eCommerce
MONGODB_DB_NAME=xCloud-eCommerce
REDIS_DATABASE=0
SERVER_PORT=81
WEBSOCKET_PORT=82
PANEL_PORT=5173
PUBLIC_APP=portal
PUBLIC_PORT=5174
# Own zone, so the portal's session cookie never mixes with another running profile's.
PORTAL_ROOT_DOMAIN=ecommerce.localhost
