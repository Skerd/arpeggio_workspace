# Car rental vertical. Overrides on top of maestro/.env (see scripts/dev/README.md).
ENABLED_MODULES=core,carRental
MONGODB_DB_NAME=xCloud-carRental
REDIS_DATABASE=2
KAFKA_PREFIX=carRental
SERVER_PORT=91
WEBSOCKET_PORT=92
PANEL_PORT=5181
PUBLIC_APP=portal
PUBLIC_PORT=5182
# Own zone, so the portal's session cookie never mixes with another running profile's.
PORTAL_ROOT_DOMAIN=carrental.localhost
