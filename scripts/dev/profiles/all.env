# Every module on one database: companies get their modules from the platform owner
# (Company.modules), not from the server. Empty ENABLED_MODULES = all installed; it
# must stay present (empty) so it overrides the value in maestro/.env.
# The public app is the portal: http://portal.localhost:<PUBLIC_PORT> lists every company,
# and http://<siteSlug>.portal.localhost:<PUBLIC_PORT> is one company's own site.
ENABLED_MODULES=
MONGODB_DB_NAME=xCloud-all
REDIS_DATABASE=5
KAFKA_PREFIX=all
SERVER_PORT=121
WEBSOCKET_PORT=122
PANEL_PORT=5211
PUBLIC_APP=portal
PUBLIC_PORT=5212
PORTAL_ROOT_DOMAIN=portal.localhost
