{
    "name": "arpeggio",
    "private": true,
    "description": "Repo-level task runner for the Arpeggio projects (sinfonia panel, maestro API, armonia shared types). Each project keeps its own package.json, lockfile and node_modules; this file only fans commands out to them.",
    "scripts": {
        "test": "npm run test:armonia && npm run test:sinfonia && npm run test:maestro",
        "test:armonia": "npm test --prefix armonia",
        "test:sinfonia": "npm test --prefix sinfonia",
        "test:maestro": "npm test --prefix maestro",
        "typecheck": "npm run typecheck:armonia && npm run typecheck:sinfonia && npm run typecheck:maestro",
        "typecheck:armonia": "cd armonia && node_modules/.bin/tsc --noEmit -p .",
        "typecheck:sinfonia": "npm run typecheck --prefix sinfonia",
        "typecheck:maestro": "cd maestro && node_modules/.bin/tsc --noEmit -p .",
        "lint": "node scripts/checks/lint.mjs",
        "check": "node scripts/checks/run.mjs",
        "check:boundaries": "node scripts/checks/run.mjs boundaries",
        "check:plugins": "node scripts/checks/run.mjs plugins",
        "check:zod": "node scripts/checks/run.mjs zod",
        "check:model-access": "node scripts/checks/run.mjs model-access",
        "check:i18n": "node scripts/checks/run.mjs i18n",
        "check:governance": "node scripts/checks/run.mjs governance",
        "check:sheet-widgets": "node scripts/checks/run.mjs sheet-widgets",
        "verify": "node scripts/verify.mjs",
        "dev": "node scripts/dev/arpeggio.mjs",
        "dev:ecommerce": "node scripts/dev/arpeggio.mjs up ecommerce",
        "dev:carRental": "node scripts/dev/arpeggio.mjs up carRental",
        "dev:dentalClinic": "node scripts/dev/arpeggio.mjs up dentalClinic",
        "dev:marketplace": "node scripts/dev/arpeggio.mjs up marketplace",
        "dev:propertyManagement": "node scripts/dev/arpeggio.mjs up propertyManagement",
        "dev:all": "node scripts/dev/arpeggio.mjs up all",
        "dev:list": "node scripts/dev/arpeggio.mjs list",
        "reset:ecommerce": "node scripts/dev/arpeggio.mjs reset ecommerce",
        "reset:carRental": "node scripts/dev/arpeggio.mjs reset carRental",
        "reset:dentalClinic": "node scripts/dev/arpeggio.mjs reset dentalClinic",
        "reset:marketplace": "node scripts/dev/arpeggio.mjs reset marketplace",
        "reset:propertyManagement": "node scripts/dev/arpeggio.mjs reset propertyManagement",
        "reset:all": "node scripts/dev/arpeggio.mjs reset all"
    }
}
